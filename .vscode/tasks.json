{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy",
      "type": "shell",
      "command": "git",
      "args": ["add", "."],
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": ["commit", "push"],
      "problemMatcher": []
    },
    {
      "label": "commit",
      "type": "shell",
      "command": "git",
      "args": ["commit", "-m", "Auto deploy"]
    },
    {
      "label": "push",
      "type": "shell",
      "command": "git",
      "args": ["push"]
    }
  ]
}